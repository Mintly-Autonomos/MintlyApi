# MongoDB — conexão Atlas SEM SRV (formato standard).
# Preferir esta forma ao invés de mongodb+srv://: o SRV depende de resolução
# de registros DNS SRV/TXT, que algumas redes/ISPs bloqueiam e causa falha de
# conexão. O formato standard lista os hosts do replica set explicitamente.
# Substitua <user>, <pass>, <host-NN>, <cluster-id> e <replica-set> pelos valores
# do seu cluster (Atlas > Connect > Drivers > "older" / non-SRV, ou via lookup DNS).
# Veja a seção "Configuração" do README para como obter os hosts.
MONGODB_URI=mongodb://<user>:<pass>@<host-00>.<cluster-id>.mongodb.net:27017,<host-01>.<cluster-id>.mongodb.net:27017,<host-02>.<cluster-id>.mongodb.net:27017/?ssl=true&replicaSet=<replica-set>&authSource=admin&retryWrites=true&w=majority
MONGODB_DB=mintly
MONGODB_AUTH_DB=mintly_auth
API_URL=https://project-api.vercel.app/

# JWT (valkyrie-jwt)
JWT_ISSUER=mintly
JWT_ACCESS_LIFETIME_SECONDS=900
JWT_REFRESH_LIFETIME_SECONDS=604800
