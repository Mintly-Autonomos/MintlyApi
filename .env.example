# MongoDB — conexão Atlas SEM SRV (formato standard), por campos separados.
# Preferir esta forma ao invés de mongodb+srv://: o SRV depende de resolução
# de registros DNS SRV/TXT, que algumas redes/ISPs bloqueiam e causa falha de
# conexão. O conector monta a connection string a partir dos campos abaixo.
# Pegue os hosts e o replica set no Atlas > Connect > Drivers > "older" / non-SRV,
# ou via lookup DNS (veja a seção "Configuração" do README).
MONGODB_USER=<user>
MONGODB_PASSWORD=<pass>
MONGODB_HOSTS=<host-00>.<cluster-id>.mongodb.net:27017,<host-01>.<cluster-id>.mongodb.net:27017,<host-02>.<cluster-id>.mongodb.net:27017
MONGODB_REPLICA_SET=<replica-set>
MONGODB_AUTH_SOURCE=admin
# MONGODB_TLS=false   # descomente só para mongo local sem TLS
#
# Alternativa: se preferir, defina MONGODB_URI com a string completa — ela tem
# precedência sobre os campos acima (usada também pelos testes).
# MONGODB_URI=mongodb://<user>:<pass>@<hosts>/?ssl=true&replicaSet=<rs>&authSource=admin&retryWrites=true&w=majority
MONGODB_DB=mintly
MONGODB_AUTH_DB=mintly_auth
API_URL=https://project-api.vercel.app/

# JWT (valkyrie-jwt)
JWT_ISSUER=mintly
JWT_ACCESS_LIFETIME_SECONDS=900
JWT_REFRESH_LIFETIME_SECONDS=604800

# E-mail de recuperação de senha (getEmailService escolhe por ordem de prioridade:
# Resend > Gmail > console/dev). Sem nenhum configurado, o token só é logado no
# console (ConsoleEmailService) — útil pra dev local sem depender de provedor externo.
# EMAIL_FROM=Mintly <noreply@seudominio.com>
# FRONTEND_URL=http://localhost:4200
#
# Opção 1: Resend (precisa de domínio verificado em resend.com/domains)
# RESEND_API_KEY=re_xxx
#
# Opção 2: Gmail SMTP (grátis, sem domínio — gera em
# myaccount.google.com/apppasswords com verificação em 2 etapas ativada)
# GMAIL_USER=seuemail@gmail.com
# GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
